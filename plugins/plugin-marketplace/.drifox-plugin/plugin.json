{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "plugin-marketplace",
    "description": "DriFox 官方插件市场 — 浏览、安装、管理插件",
    "version": "0.3.2",
    "author": {
        "name": "DriFox Contributors"
    },
    "homepage": "https://github.com/martin98-afk/drifox-plugins",
    "license": "GPL-3.0-or-later",
    "type": "system",
    "api_version": 2,
    "capabilities": [
        "config.read",
        "input.write"
    ],
    "components": {
        "ui": true
    },
    "config_schema": {
        "title": "插件市场",
        "fields": [
            {
                "key": "auto_update_enabled",
                "label": "自动更新插件",
                "type": "bool",
                "default": false,
                "description": "应用运行期间后台定时检查插件更新并自动安装（默认关闭；打开插件市场也会即时检查）"
            }
        ]
    }
}
