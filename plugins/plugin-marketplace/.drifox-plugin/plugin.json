{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "plugin-marketplace",
    "display_name": {
        "zh": "插件市场"
    },
    "description": "DriFox 官方插件市场 — 浏览、安装、管理插件，并把搜索/安装/卸载/更新/启停开放给 AI 工具",
    "version": "0.6.0",
    "author": {
        "name": "DriFox Contributors"
    },
    "homepage": "https://github.com/martin98-afk/drifox-plugins",
    "license": "GPL-3.0-or-later",
    "type": "system",
    "api_version": 2,
    "module_prefixes": [
        "_plugin_marketplace_ui"
    ],
    "capabilities": [
        "config.read",
        "input.write"
    ],
    "components": {
        "ui": true,
        "tools": true
    },
    "config_schema": {
        "title": "插件市场",
        "fields": [
            {
                "key": "auto_update_enabled",
                "label": "自动更新插件",
                "type": "bool",
                "default": false,
                "description": "应用运行期间后台定时检查插件更新并自动安装（默认关闭；打开插件市场也会即时检查）"
            }
        ]
    }
}
