{
  "icon": {
    "light": "icon.svg",
    "dark": "icon_dark.svg"
  },
  "name": "system-web",
  "display_name": {
      "zh": "内置网络工具"
  },
  "description": "DriFox 内置网络工具：网页搜索与抓取（Tavily / TinyFish，含 API Key 配置）",
  "version": "1.0.0",
  "author": {
    "name": "DriFoxx Team"
  },
  "homepage": "https://github.com/martin98-afk/DriFox",
  "license": "GPL-3.0-or-later",
  "type": "system",
  "api_version": 2,
  "min_host_version": "0.7.2",
  "components": {
    "tools": true
  },
  "capabilities": [
    "plugin.config.read"
  ],
  "config_schema": {
    "title": "网页搜索 API Key",
    "fields": [
      {
        "key": "tavily_api_key",
        "label": "Tavily 搜索",
        "type": "password",
        "default": "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",
        "env": "TAVILY_API_KEY",
        "placeholder": "TAVILY_API_KEY"
      },
      {
        "key": "tavily_homepage",
        "label": "Tavily 官网",
        "type": "link",
        "url": "https://app.tavily.com",
        "placeholder": "app.tavily.com"
      },
      {
        "key": "tinyfish_api_key",
        "label": "TinyFish 搜索",
        "type": "password",
        "default": "sk-tinyfish-fAcFQS87D9PVr6jj_-8eBKT4CnK5D7IU",
        "env": "TINYFISH_API_KEY",
        "placeholder": "TINYFISH_API_KEY"
      }
    ]
  }
}
