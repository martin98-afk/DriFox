{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "system-subagent",
    "display_name": {
        "zh": "子智能体"
    },
    "description": "子智能体 — assistant 消息卡末尾展示任务运行区（旋转图标、工具计数、上下文用量、进入会话/停止），并提供 /subagents 命令与会话卡",
    "version": "0.2.0",
    "author": {
        "name": "DriFox Contributors"
    },
    "homepage": "https://github.com/martin98-afk/DriFox",
    "license": "GPL-3.0-or-later",
    "type": "system",
    "api_version": 2,
    "components": {
        "commands": true,
        "tools": true,
        "ui": true
    },
    "capabilities": [
        "config.read",
        "config.write",
        "model.config",
        "model.config_for",
        "plugin.config.read",
        "plugin.config.write",
        "provider.list",
        "model.enumerate",
        "session.read",
        "session.send",
        "storage.db",
        "subagent.run",
        "ui.notify",
        "ui.card.show"
    ],
    "config_schema": {
        "title": "子智能体默认模型",
        "fields": [
            {
                "key": "subagent_model",
                "label": "默认模型",
                "type": "model",
                "default": "",
                "description": "所有子智能体任务共用的模型；留空跟随当前会话模型。也可通过 /subagents --model= 修改"
            }
        ]
    },
    "module_prefixes": [
        "system_subagent_manager"
    ]
}
