{
    "pyright": {
        "command": "pyright-langserver",
        "args": ["--stdio"],
        "extensionToLanguage": {
            ".py": "python",
            ".pyi": "python"
        },
        "initializationOptions": {},
        "settings": {
            "python.analysis.typeCheckingMode": "basic",
            "python.analysis.autoSearchPaths": true,
            "python.analysis.useLibraryCodeForTypes": true
        },
        "startupTimeout": 10000,
        "maxRestarts": 3,
        "transport": "stdio"
    }
}
