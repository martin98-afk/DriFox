{
    "icon": {
        "light": "icon.svg",
        "dark": "icon_dark.svg"
    },
    "name": "file-tree",
    "display_name": {
        "zh": "文件树"
    },
    "description": "当前项目文件树浏览 — 直观展示项目目录结构，支持图片/文本预览（语法高亮、换行开关）、图片全局面板（可自由拖拽平移与缩放）、用指定程序打开、右键菜单与实时文件监听；树页眼睛按钮开启「快捷预览」在树下方直接选中即看（不必双击进入预览页）；可把文件或选中文字（带路径与行号）引用到对话输入框；并接管主程序里可预览文件的打开动作（工具卡文件地址点击直接用本页预览）",
    "version": "0.7.0",
    "author": {
        "name": "DriFox Contributors"
    },
    "homepage": "https://github.com/martin98-afk/DriFox",
    "license": "GPL-3.0-or-later",
    "type": "user",
    "components": {
        "ui": true
    },
    "api_version": 2,
    "capabilities": [
        "file.open",
        "window.workbench",
        "window.host",
        "input.read",
        "input.write",
        "ui.notify"
    ]
}
