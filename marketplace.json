            "icon": {
                "light": "icons/icon_light.svg",
                "dark": "icons/icon.svg"
            }
        },
        {
            "name": "assistant_hub",
            "description": "智能体助手中心 — 助手切换 + 人格（persona）切换：人格是只读的内置预设（personas/<id>/persona.md），点卡片即切换；新增人格在对话里说「创建新人格」走 persona-creator 技能。含置顶记忆（pinned.md）、当下/长期记忆、Dream 自动整理、专属技能、头像库、预置工具三档快捷切换（全量/只读/极简，控制初始注入的工具 schema，未注入的可经 tool_search 搜索、tool_execute 中转调用）、经验库（recall/record_experience 工具 + 每日反思，分类少而稳定）。激活助手后通过系统提示词替换当前智能体身份注入（不改动原 build 智能体，仍可被子智能体调用）。",
            "version": "0.3.0",
            "author": "DriFox Contributors",
            "license": "MIT",
            "categories": [
                "ui",
                "tool"
            ],
            "source": {
                "type": "git-subdir",
                "url": "https://github.com/martin98-afk/DriFox",
                "path": "plugins/assistant_hub",
                "ref": "master"
            },
            "components": {
                "ui": true,
                "hooks": true,
                "tools": true,
                "skills": true,
                "loop_policies": true
            },
            "homepage": "https://github.com/martin98-afk/DriFox",
            "icon": {
                "light": "D:/work/DriFox/plugins/assistant_hub/icons/avatars/avatar-13.png",
                "dark": "D:/work/DriFox/plugins/assistant_hub/icons/avatars/avatar-13.png"
            }
        },
